{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "description": "Folio P0 for claude.ai: conversation outline, exact jump, bookmarks and local lexical search (Chrome Manifest V3 extension).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node src/tools/build.mjs",
    "icons": "node src/tools/make-icons.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/**/*.test.ts\"",
    "test": "node src/tools/build.mjs && node --test --test-concurrency=1 \"tests/**/*.test.ts\""
  }
}
